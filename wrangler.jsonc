// Cloudflare Workers: the site is the public/ folder (generated by build.py), served as static assets; the Worker
// (src/worker.js) runs only for /get/* - the counted download links. The D1 database is created by the first deploy.
{
  "name": "axellsdojo-com",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/get/*"]
  },
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  "d1_databases": [{ "binding": "DB", "database_name": "axellsdojo-downloads" }],
  "observability": { "enabled": true }
}
